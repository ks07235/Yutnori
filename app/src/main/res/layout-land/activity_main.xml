<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/top_panel"
        android:layout_width="226dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/shape_icon_button"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_status_pill"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="4"
            android:minHeight="52dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"
            android:text="@string/initial_status"
            android:textColor="@color/text_status"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_finished_summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/shape_button_restart"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/new_game"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.example.yutnoriapp.BoardSurfaceLayout
        android:id="@+id/board_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_board_shell"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="3dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/control_panel"
        app:layout_constraintHeight_max="720dp"
        app:layout_constraintStart_toEndOf="@id/top_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <com.example.yutnoriapp.YutBoardView
            android:id="@+id/board_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.yutnoriapp.BoardOverlayLayout
            android:id="@+id/board_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </com.example.yutnoriapp.BoardSurfaceLayout>

    <ScrollView
        android:id="@+id/control_panel"
        android:layout_width="292dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_control_panel"
        android:elevation="10dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/waiting_overview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/waiting_area"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/action_log_rail"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="0dp"
                    android:background="@drawable/shape_action_log_rail"
                    android:contentDescription="@string/recent_history"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/turn_tools"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_timer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/shape_status_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/timer_default"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_time_stop"
                    style="@style/UtilityActionButton"
                    android:layout_width="72dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/shape_button_utility"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/pause_time"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_end_turn"
                    style="@style/PrimaryActionButton"
                    android:layout_width="78dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/shape_button_end_turn"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/end_turn"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/results_row"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_results"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btn_undo_roll"
                    style="@style/UtilityActionButton"
                    android:layout_width="92dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/shape_button_utility"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/undo_last"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/yut_row_top"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_bdo"
                        style="@style/YutInputButton"
                        app:drawableTopCompat="@drawable/ic_yut_backdo"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_backdo_steps" />

                    <TextView
                        android:id="@+id/btn_do"
                        style="@style/YutInputButton"
                        app:drawableTopCompat="@drawable/ic_yut_do"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_do_steps" />

                    <TextView
                        android:id="@+id/btn_gae"
                        style="@style/YutInputButton"
                        app:drawableTopCompat="@drawable/ic_yut_gae"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_gae_steps" />
                </LinearLayout>

            <LinearLayout
                android:id="@+id/yut_row_bottom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_geol"
                        style="@style/YutInputButton"
                        app:drawableTopCompat="@drawable/ic_yut_geol"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_geol_steps" />

                    <TextView
                        android:id="@+id/btn_yut"
                        style="@style/YutInputButton"
                        android:background="@drawable/shape_button_yut_bonus"
                        app:drawableTopCompat="@drawable/ic_yut_yut"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_yut_steps" />

                    <TextView
                        android:id="@+id/btn_mo"
                        style="@style/YutInputButton"
                        android:background="@drawable/shape_button_yut_bonus"
                        app:drawableTopCompat="@drawable/ic_yut_mo"
                        android:drawablePadding="4dp"
                        android:text="@string/yut_mo_steps" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btn_toggle_info"
        android:layout_width="48dp"
        android:layout_height="96dp"
        android:background="@drawable/shape_drawer_tab_left"
        android:contentDescription="@string/info_panel_toggle"
        android:elevation="12dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/info"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/top_panel"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_toggle_controls"
        android:layout_width="48dp"
        android:layout_height="108dp"
        android:background="@drawable/shape_drawer_tab_right"
        android:contentDescription="@string/controls_panel_toggle"
        android:elevation="12dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/input"
        android:textColor="@color/btn_text_color"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/control_panel"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/setup_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_main"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:padding="22dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            layout="@layout/view_team_setup_content"
            android:layout_width="460dp"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
