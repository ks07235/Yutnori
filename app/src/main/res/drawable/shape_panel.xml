<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape>
            <solid android:color="@color/bg_main_deep"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape>
            <gradient
                android:startColor="@color/surface_panel"
                android:endColor="@color/surface_panel_warm"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="@color/surface_panel_stroke"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
