<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="@color/hanji_button_pressed" />
                    <stroke android:width="2dp" android:color="@color/board_line" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="@color/hanji_button_shadow" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <gradient
                        android:angle="270"
                        android:endColor="@color/accent_gold_soft"
                        android:startColor="@color/hanji_button" />
                    <stroke android:width="2dp" android:color="@color/board_line_soft" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
