<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <solid android:color="@color/bg_main_deep" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/surface_panel_warm"
                android:startColor="@color/surface_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/board_line_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
