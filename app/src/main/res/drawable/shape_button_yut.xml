<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="@color/btn_yut_disabled" />
                    <stroke android:width="1dp" android:color="@color/surface_panel_stroke" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="@color/hanji_button_pressed" />
                    <stroke android:width="2dp" android:color="@color/board_line" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="@color/hanji_button_shadow" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="@color/hanji_button" />
                    <stroke android:width="2dp" android:color="@color/board_line_soft" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="39dp" android:left="8dp" android:right="8dp" android:top="2dp">
                <shape>
                    <solid android:color="#65FFFFFF" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
