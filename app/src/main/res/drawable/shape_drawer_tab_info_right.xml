<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/button_utility_pressed" />
            <stroke android:width="1dp" android:color="@color/board_line_soft" />
            <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_panel" />
            <stroke android:width="1dp" android:color="@color/surface_panel_stroke" />
            <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp" />
        </shape>
    </item>
</selector>