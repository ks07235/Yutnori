<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#c58a26"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <gradient
                        android:startColor="@color/accent_gold_soft"
                        android:endColor="@color/accent_gold"
                        android:angle="270"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/board_line"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/button_utility_pressed"/>
            <stroke
                android:width="1dp"
                android:color="@color/board_line_soft"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="@color/hanji_button_shadow"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@color/button_utility"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/surface_panel_stroke"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
