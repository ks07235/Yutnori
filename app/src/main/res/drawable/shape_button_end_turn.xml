<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/btn_yut_disabled"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <gradient
                        android:startColor="@color/button_end"
                        android:endColor="@color/button_end_pressed"
                        android:angle="270"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_gold_soft"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#0f3036"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <gradient
                        android:startColor="@color/button_end"
                        android:endColor="@color/button_end_pressed"
                        android:angle="270"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_gold"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item
                android:left="8dp"
                android:top="2dp"
                android:right="8dp"
                android:bottom="29dp">
                <shape>
                    <solid android:color="#30ffffff"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
