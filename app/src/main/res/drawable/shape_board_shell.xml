<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <solid android:color="@color/surface_board_shadow" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <solid android:color="@color/surface_board" />
            <stroke
                android:width="2dp"
                android:color="@color/board_line_soft" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
