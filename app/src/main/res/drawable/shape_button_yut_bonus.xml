<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="@color/accent_gold_soft"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/board_line"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#c99b42"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <gradient
                        android:startColor="@color/hanji_button"
                        android:endColor="@color/accent_gold_soft"
                        android:angle="270"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/accent_gold"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item
                android:left="8dp"
                android:top="2dp"
                android:right="8dp"
                android:bottom="39dp">
                <shape>
                    <solid android:color="#75ffffff"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
