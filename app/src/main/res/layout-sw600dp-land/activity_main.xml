<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:padding="14dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/top_panel"
        android:background="@drawable/shape_panel"
        android:paddingLeft="14dp"
        android:paddingTop="13dp"
        android:paddingRight="14dp"
        android:paddingBottom="13dp"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/btn_settings"
                android:background="@drawable/shape_icon_button"
                android:padding="8dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_status"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/text_status"
            android:background="@drawable/shape_status_pill"
            android:paddingLeft="9dp"
            android:paddingTop="7dp"
            android:paddingRight="9dp"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/initial_status"
            android:maxLines="4"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"/>
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:id="@+id/layout_finished_summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:layout_weight="1"/>
        <Button
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/btn_text_color"
            android:id="@+id/btn_restart"
            android:background="@drawable/shape_button_restart"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:text="@string/new_game"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
    <com.example.yutnoriapp.SquareFrameLayout
        android:id="@+id/board_container"
        android:background="@drawable/shape_board_shell"
        android:padding="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:elevation="3dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/control_panel"
        app:layout_constraintHeight_max="860dp"
        app:layout_constraintStart_toEndOf="@+id/top_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <com.example.yutnoriapp.YutBoardView
            android:id="@+id/board_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.example.yutnoriapp.SquareFrameLayout>
    <ScrollView
        android:id="@+id/control_panel"
        android:background="@drawable/shape_control_panel"
        android:paddingLeft="13dp"
        android:paddingTop="13dp"
        android:paddingRight="13dp"
        android:paddingBottom="13dp"
        android:scrollbars="none"
        android:layout_width="340dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:elevation="2dp"
        android:paddingHorizontal="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/waiting_overview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/waiting_area"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/action_log_rail"
                    android:background="@drawable/shape_action_log_rail"
                    android:layout_width="68dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/recent_history"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/turn_tools"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp">
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:id="@+id/text_timer"
                    android:background="@drawable/shape_status_pill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/timer_default"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/button_text_dark"
                    android:id="@+id/btn_time_stop"
                    android:background="@drawable/shape_button_utility"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="76dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="@string/pause_time"
                    android:textAllCaps="false"
                    android:layout_marginStart="7dp"
                    android:backgroundTint="@null"
                    android:paddingHorizontal="4dp"
                    style="@style/UtilityActionButton"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/button_text_light"
                android:id="@+id/btn_end_turn"
                android:background="@drawable/shape_button_end_turn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:minWidth="0dp"
                android:text="@string/end_turn"
                android:textAllCaps="false"
                android:backgroundTint="@null"
                android:paddingHorizontal="8dp"
                style="@style/PrimaryActionButton"/>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:fillViewport="true"
                android:overScrollMode="never">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_results"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </HorizontalScrollView>
            <Button
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/button_text_dark"
                android:id="@+id/btn_undo_roll"
                android:background="@drawable/shape_button_utility"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:minWidth="0dp"
                android:text="@string/undo_last"
                android:textAllCaps="false"
                android:backgroundTint="@null"
                android:paddingHorizontal="8dp"
                style="@style/UtilityActionButton"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp">
                    <TextView
                        android:id="@+id/btn_bdo"
                        android:text="@string/yut_backdo_steps"
                        android:drawableTop="@drawable/ic_yut_backdo"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                    <TextView
                        android:id="@+id/btn_do"
                        android:text="@string/yut_do_steps"
                        android:drawableTop="@drawable/ic_yut_do"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                    <TextView
                        android:id="@+id/btn_gae"
                        android:text="@string/yut_gae_steps"
                        android:drawableTop="@drawable/ic_yut_gae"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/btn_geol"
                        android:text="@string/yut_geol_steps"
                        android:drawableTop="@drawable/ic_yut_geol"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                    <TextView
                        android:id="@+id/btn_yut"
                        android:background="@drawable/shape_button_yut_bonus"
                        android:text="@string/yut_yut_steps"
                        android:drawableTop="@drawable/ic_yut_yut"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                    <TextView
                        android:id="@+id/btn_mo"
                        android:background="@drawable/shape_button_yut_bonus"
                        android:text="@string/yut_mo_steps"
                        android:drawableTop="@drawable/ic_yut_mo"
                        android:drawablePadding="4dp"
                        style="@style/YutInputButton"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/setup_panel"
        android:background="@color/bg_main"
        android:padding="22dp"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/shape_panel"
            android:padding="24dp"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:elevation="6dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">
                <TextView
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/team_selection"
                    android:includeFontPadding="false"/>
                <ImageButton
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_setup_settings"
                    android:background="@drawable/shape_icon_button"
                    android:padding="9dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"/>
            </FrameLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/choose_team_count"/>
            <Button
                android:id="@+id/btn_team_2"
                android:layout_marginTop="20dp"
                android:text="@string/start_two_teams"
                android:backgroundTint="@null"
                style="@style/TeamSetupButton"/>
            <Button
                android:id="@+id/btn_team_3"
                android:layout_marginTop="9dp"
                android:text="@string/start_three_teams"
                android:backgroundTint="@null"
                style="@style/TeamSetupButton"/>
            <Button
                android:id="@+id/btn_team_4"
                android:layout_marginTop="9dp"
                android:text="@string/start_four_teams"
                android:backgroundTint="@null"
                style="@style/TeamSetupButton"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
