    <string name="about">About</string>
    <string name="privacy_policy">Privacy policy</string>
    <string name="privacy_policy_body">Yutnori does not collect, transmit, share, or sell personal or device information. Game settings, progress, and history are stored only on this device. The app does not use accounts, advertising, analytics, or third-party tracking. Local data may be removed when the app is uninstalled. For privacy inquiries, contact the developer using the email address shown on the Google Play listing.</string>
